#!/usr/bin/env python3
"""Standalone wrapper for skill-safety-guard.

Usable both as a CLI tool and as the entry point for the Pi Skill.
"""
import sys
from pathlib import Path

# Windows 終端 UTF-8 兼容性
if sys.platform.startswith("win"):
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

# 確保 src/ 在 Python path 中（開發模式）
src_path = Path(__file__).resolve().parent.parent / "src"
if src_path.exists():
    sys.path.insert(0, str(src_path))

from skill_safety_guard.cli import main

if __name__ == "__main__":
    sys.exit(main())